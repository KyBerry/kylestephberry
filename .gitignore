# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by content-collections
.content-collections/

# Generated by scripts/derive-design-blurhashes.ts (blur cache)
content/.cache/

# Generated by Pagefind (Plan 7)
public/_pagefind/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp

# MCP tooling artefacts
.playwright-mcp/

# Agent planning docs & internal working notes — local-only, never committed.
# The superpowers agent framework writes plans/specs under docs/; keeping the
# whole directory ignored guarantees none of it can enter git history.
/docs/
